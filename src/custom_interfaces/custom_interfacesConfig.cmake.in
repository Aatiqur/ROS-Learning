# - Config file for the custom_interfaces package
# It defines the following variables
#  custom_interfaces_INCLUDE_DIRS - include directories for FooBar
#  custom_interfaces_LIBRARIES    - libraries to link against
#  custom_interfaces_EXECUTABLE   - the bar executable

set(custom_interfaces_INCLUDE_DIRS "@CONF_INCLUDE_DIRS@")

# Our library dependencies (contains definitions for IMPORTED targets)
include("${custom_interfaces_DIR}/export_custom_interfaces.cmake")

# These are IMPORTED targets created by custom_interfacesTargets.cmake


